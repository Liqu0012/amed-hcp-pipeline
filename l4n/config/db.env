# Independent new-container namespace. Old configs and STOP files stay intact.
L4N_ROOT=/data/juntendodb/amedhcp/l4n_pipeline/l4n
HCP_WORKFLOW_ROOT=$L4N_ROOT
HCP_METRICS_ROOT=/data/juntendodb/amedhcp/resource_metrics
HCP_STUDY=/data/juntendodb/amedhcp/l4n_study
HCP_WORKFLOW_LOG_DIR=/data/juntendodb/amedhcp/l4n_logs
L4N_INPUTS=/data/juntendodb/amedhcp/l4n_inputs
L4N_LEGACY_STUDY=/data/juntendodb/amedhcp/study
L4N_OLD_QUEUE=
HCP_IMAGE=/data/juntendodb/amedhcp/containers/l4n-bmb_latest.sif
HCP_FS_LICENSE=/home/z.chang.xw/.licenses/freesurfer/license.txt
HCP_CONTAINER_RUNTIME=apptainer
L4N_RUNTIME=apptainer
L4N_BINDS=/data/juntendodb
APPTAINER_BINDPATH=$L4N_BINDS
SINGULARITY_BINDPATH=$L4N_BINDS
L4N_IMAGE_READY=/data/juntendodb/amedhcp/containers/l4n-bmb_latest.sif.ready.json
L4N_CANARY_OK=/data/juntendodb/amedhcp/l4n_logs/canary.ok
HCP_NODE_MANIFEST=/data/juntendodb/amedhcp/l4n_manifests/remaining.tsv
HCP_NODE_QUEUE_DIR=/data/juntendodb/amedhcp/l4n_logs/node_pipeline
HCP_NODE_JOB_NAME=hcp_l4n_node
HCP_CPU_PARTITION=ccalc
HCP_NODE_PARTITION=ccalc
HCP_NODE_CPUS=64
HCP_NODE_MEM=400G
HCP_NODE_TIME=3-00:00:00
HCP_NODE_CPU_BUDGET=60
HCP_NODE_MEM_BUDGET_GB=360
HCP_NODE_MAX_SESSIONS=4
HCP_NODE_DISK_MIN_FREE_GB=500
HCP_UPLOAD_MIN_AGE_MIN=30
HCP_SCRATCH_ROOT=/tmp
HCP_NODE_CONVERT_THREADS=4
HCP_NODE_STRUCTURAL_THREADS=8
HCP_NODE_DIFFUSION_THREADS=16
HCP_NODE_DIFFUSION_MIN_THREADS=12
HCP_NODE_DIFFUSION_MEM_GB=30
HCP_NODE_DIFFUSION_MAX=2
HCP_NODE_MEMPROF=1
# GPU is requested only after new structural processing is complete.
L4N_EXTERNAL_DIFFUSION=1
L4N_GPU_PARTITION=gcalc1
L4N_GPU_GRES=gpu:l40s:1
HCP_NODE_DIFFUSION_THREADS=1
HCP_NODE_DIFFUSION_MIN_THREADS=1
HCP_NODE_DIFFUSION_MEM_GB=0.25
HCP_NODE_DIFFUSION_MAX=2
