# HOKUSAI BW2, account haruka74 (wang). Self-contained layout, nothing outside
# /home/haruka74/AMED_HCP is used; the home also holds unrelated projects.
#   containers/  qunex_suite-1.5.1.sif (same image as ziqing and DB)
#   pipeline/    git clone, branch hokusai-pipeline
#   raw/         uploaded session zips
#   hcp_study/   results; hcp_workflow_logs/, manifests/, licenses/
# Home quota is shared with the other projects: check `df -h ~` before a batch.
A=/home/haruka74/AMED_HCP
HCP_STUDY=$A/hcp_study
HCP_IMAGE=$A/containers/qunex_suite-1.5.1.sif
HCP_FS_HOME=
HCP_FS_LICENSE=$A/licenses/freesurfer/license.txt
HCP_STAGE_SCRIPT_DIR=$A/pipeline/hokusai/stages
HCP_WORKFLOW_LOG_DIR=$A/hcp_workflow_logs
# Session study directories may live in /lustre/tmp_work (no storage fee; files
# not modified for 7 days are deleted) behind a symlink in HCP_STUDY.
SINGULARITY_BINDPATH=$A,/lustre/tmp_work/haruka74_hcp
APPTAINER_BINDPATH=$A,/lustre/tmp_work/haruka74_hcp
HCP_SLURM_ACCOUNT=rb240007
HCP_SLURM_QOS=normal
HCP_CPU_PARTITION=mpc
HCP_SLURM_EXCLUDE=bwmpc049,bwmpc253
HCP_MAX_PARALLEL=64
HCP_STRUCTURAL_MAX_PARALLEL=12
HCP_CONVERT_MAX_PARALLEL=12
HCP_PREEDDY_MAX_PARALLEL=12
HCP_EDDY_MAX_PARALLEL=12
HCP_POSTEDDY_MAX_PARALLEL=12
HCP_FMRI_MAX_PARALLEL=12
HCP_ICAFIX_MAX_PARALLEL=12
HCP_MSMALL_MAX_PARALLEL=12
HCP_DEDRIFT_MAX_PARALLEL=12
HCP_CONTAINER_RUNTIME=singularity
HCP_SCRATCH_ROOT=/tmp

S=$A/pipeline/hokusai/stages
HCP_STRUCT_COMMAND="bash $S/hcp_full_test_session.sh"
HCP_CONVERT_COMMAND="bash $S/hcp_convert_session.sh"
HCP_PREEDDY_COMMAND="bash $S/hcp_diffusion_preeddy.sh"
HCP_EDDY_COMMAND="bash $S/hcp_diffusion_eddy_cpu.sh"
HCP_POSTEDDY_COMMAND="bash $S/hcp_diffusion_posteddy.sh"
HCP_FMRI_COMMAND="bash $S/hcp_fmri_session.sh"
HCP_ICAFIX_COMMAND="bash $S/hcp_icafix_session.sh"
HCP_MSMALL_COMMAND="bash $S/hcp_msmall_session.sh"
HCP_DEDRIFT_COMMAND="bash $S/hcp_dedrift_session.sh"

# mpc node: 112 CPU / 112 GiB
HCP_STRUCT_CPUS=112
HCP_STRUCT_MEM=112G
HCP_CONVERT_CPUS=112
HCP_CONVERT_MEM=112G
HCP_PREEDDY_CPUS=112
HCP_PREEDDY_MEM=112G
HCP_EDDY_TIME=12:00:00
HCP_EDDY_CPUS=112
HCP_EDDY_MEM=112G
HCP_POSTEDDY_CPUS=112
HCP_POSTEDDY_MEM=112G
HCP_FMRI_CPUS=112
HCP_FMRI_MEM=112G
HCP_ICAFIX_CPUS=112
HCP_ICAFIX_MEM=112G
HCP_MSMALL_CPUS=112
HCP_MSMALL_MEM=112G
HCP_DEDRIFT_CPUS=112
HCP_DEDRIFT_MEM=112G

# QC gate (hcp_qc_session.py)
HCP_QC_MAX_PARALLEL=12
HCP_QC_TIME=00:30:00
HCP_QC_CPUS=2
HCP_QC_MEM=8G
