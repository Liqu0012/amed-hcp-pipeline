source /data/juntendodb/amedhcp/pipeline/hokusai/workflow/config/db.env

# Jobs queued before 2026-10-30 carry an older copy of slurm/stage1_worker.sh (sbatch stores
# the script at submission); make them run the current one. Only the batch script
# itself (slurm_script) re-executes, not run-stage.sh, which also reads this file.
if [[ "${0##*/}" == slurm_script && -z "${HCP_STAGE1_REEXEC:-}" ]]; then
  export HCP_STAGE1_REEXEC=1
  exec bash /data/juntendodb/amedhcp/pipeline/hokusai/workflow/slurm/stage1_worker.sh "$cfg"
fi

# Rolling stage 1 (structural + PreEddy) over the upload folders; new zips
# are picked up automatically once complete. Extend HCP_SOURCE_DIRS for more sites.
# 2026-10-29: all folders holding sessions assigned to digital brain (2,167 in
# tracking/HCP_stage_tracker.xlsx), plus amedhcp/raw where the remaining 680
# (BMB_UHI_PT 632, BMB_KyotoU2_PT 48) are being uploaded from wu. The first 672
# (BMB_ATRG3-1_PT, BMB_JTD_PT) are already done and are skipped by their markers.
A=/data/juntendodb/amedhcp1028
HCP_SOURCE_DIRS=$A/BMB_ATRG3-1_PT:$A/BMB_JTD_PT:$A/BMB_KyotoU2_PT:$A/BMB_ShowaU2_PT:$A/BMB_ShowaU_PT:$A/BMB_ShowaU_PT/BMB_ShowaU_PT_2022:$A/BMB_TMG_PT:$A/BMB_UHI_PT:$A/BMB_TS/BMB_ATR_TS:$A/BMB_TS/BMB_ChibaU_TS:$A/BMB_TS/BMB_JTD_TS:$A/BMB_TS/BMB_KRC_TS:$A/BMB_TS/BMB_KeioU_TS:$A/BMB_TS/BMB_NCNP_TS:$A/BMB_TS/BMB_ShowaU_TS:$A/BMB_TS/BMB_TMG_TS:/data/juntendodb/amedhcp/raw/BMB_UHI_PT:/data/juntendodb/amedhcp/raw/BMB_KyotoU2_PT
HCP_INCLUDE_REGEX=_HARP_
# Sessions already processed, downloaded to wu and QC-accepted (1,083), and the
# 595 sessions computed on HOKUSAI (ziqing 295, haruka74 300).
HCP_EXCLUDE_LIST=/data/juntendodb/amedhcp/lists/stage1_exclude_20261029.txt
HCP_QUEUE_DIR=/data/juntendodb/amedhcp/logs/stage1_queue
HCP_WORKER_NAME=hcp_stage1
HCP_WORKER_SLOTS=24
HCP_WORKER_THREADS=8
HCP_WORKER_MEM=1500G
HCP_WORKER_TIME=3-00:00:00
HCP_WORKER_MARGIN_SEC=50400
HCP_UPLOAD_MIN_AGE_MIN=30
HCP_WORKER_POLL_SEC=300
