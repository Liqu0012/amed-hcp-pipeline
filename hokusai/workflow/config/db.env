# DB cluster (digitalbrain.brainminds.jp), rebuilt 2026-10-28 after the storage
# reset. Same QuNex 1.5.1 image and stage scripts as HOKUSAI; eddy on GPU.
# Layout: /data/juntendodb/amedhcp/{containers,pipeline,study,lists,logs}
HCP_STUDY=/data/juntendodb/amedhcp/study
HCP_IMAGE=/data/juntendodb/amedhcp/containers/qunex_suite-1.5.1.sif
HCP_FS_HOME=
HCP_FS_LICENSE=/home/z.chang.xw/.licenses/freesurfer/license.txt
HCP_STAGE_SCRIPT_DIR=/data/juntendodb/amedhcp/pipeline/hokusai/stages
HCP_WORKFLOW_LOG_DIR=/data/juntendodb/amedhcp/logs/workflow
HCP_CONTAINER_RUNTIME=apptainer
APPTAINER_BINDPATH=/data/juntendodb
HCP_SCRATCH_ROOT=/tmp

# Slurm: account kobetsu_juntendodb (default), limits node=6, h100=4, MaxWall 3 days
HCP_SLURM_ACCOUNT=
HCP_SLURM_QOS=
HCP_CPU_PARTITION=ccalc
HCP_MAX_PARALLEL=6

S=/data/juntendodb/amedhcp/pipeline/hokusai/stages
HCP_STRUCT_COMMAND="bash $S/hcp_full_test_session.sh"
HCP_CONVERT_COMMAND="bash $S/hcp_convert_session.sh"
HCP_PREEDDY_COMMAND="bash $S/hcp_diffusion_preeddy.sh"
HCP_EDDY_COMMAND="bash $S/hcp_diffusion_eddy_cuda.sh"
HCP_POSTEDDY_COMMAND="bash $S/hcp_diffusion_posteddy.sh"
HCP_FMRI_COMMAND="bash $S/hcp_fmri_session.sh"
HCP_ICAFIX_COMMAND="bash $S/hcp_icafix_session.sh"
HCP_MSMALL_COMMAND="bash $S/hcp_msmall_session.sh"
HCP_DEDRIFT_COMMAND="bash $S/hcp_dedrift_session.sh"

# Per-session (non-packed) submit.sh resources
HCP_STRUCT_CPUS=8
HCP_STRUCT_MEM=32G
HCP_STRUCT_TIME=2-00:00:00
HCP_EDDY_TIME=1-00:00:00
HCP_QC_TIME=01:00:00
HCP_QC_CPUS=2
HCP_QC_MEM=8G
