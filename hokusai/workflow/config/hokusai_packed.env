source /home/ziqing/hcp-portable-workflow/config/hokusai.env

# One Slurm array element reserves one whole mpc node (112 CPU / 112 GiB) and
# runs a pack of sessions in parallel inside it. 5% of the node is left for
# I/O, so each pack uses at most 106 CPU and 106 GiB.
# Pack size = min(106 / threads, 106 GiB / peak RSS per session); peak RSS per
# session from the Aug-2026 HOKUSAI runs (sacct MaxRSS of the node / pack size).
HCP_PACKED_NODE_CPUS=112
HCP_PACKED_NODE_MEM=112G
HCP_PACKED_MAX_PARALLEL=12

#                        sessions x threads = CPU   peak/session  pack peak
HCP_CONVERT_PACK_SIZE=26           # 26 x 4 = 104   0.5 GB         13 GB
HCP_CONVERT_CPUS_PER_SESSION=4
HCP_STRUCTURAL_PACK_SIZE=21        # 21 x 5 = 105   3.1 GB         65 GB
HCP_STRUCTURAL_CPUS_PER_SESSION=5
HCP_STRUCT_TIME=1-00:00:00         # fewer threads than before (16): allow the full mpc day
HCP_PREEDDY_PACK_SIZE=26           # 26 x 4 = 104   0.9 GB         24 GB
HCP_PREEDDY_CPUS_PER_SESSION=4
# CPU eddy (memory-bound): 112 threads took ~5 h, ~168 CPU-hours, 23-27 GB.
# Single-thread eddy would need ~7 days (> 3-day limit). 3 x 35 on mpc:
# mpc_l (3-day) was estimated to start 3 weeks later than mpc on 2026-10-28.
HCP_EDDY_PACK_SIZE=3               #  3 x 35 = 105  26.6 GB         80 GB
HCP_EDDY_CPUS_PER_SESSION=35
HCP_EDDY_TIME=1-00:00:00            # 112 threads took ~5 h; 35 threads expected 8-16 h
HCP_POSTEDDY_PACK_SIZE=21          # 21 x 5 = 105   4.7 GB         99 GB
HCP_POSTEDDY_CPUS_PER_SESSION=5
HCP_FMRI_PACK_SIZE=10              # 10 x 10 = 100 10.0 GB        100 GB
HCP_FMRI_CPUS_PER_SESSION=10
HCP_FMRI_TIME=12:00:00             # 28 -> 10 threads
HCP_ICAFIX_PACK_SIZE=5             #  5 x 21 = 105 19.1 GB         96 GB
HCP_ICAFIX_CPUS_PER_SESSION=21
HCP_MSMALL_PACK_SIZE=21            # 21 x 5 = 105   3.2 GB         67 GB
HCP_MSMALL_CPUS_PER_SESSION=5
HCP_MSMALL_TIME=12:00:00           # 28 -> 5 threads (was 1.7 h)
HCP_DEDRIFT_PACK_SIZE=5            #  5 x 21 = 105 18.5 GB         93 GB
HCP_DEDRIFT_CPUS_PER_SESSION=21
HCP_QC_PACK_SIZE=26                # 26 x 4 = 104   numeric QC only
HCP_QC_CPUS_PER_SESSION=4
