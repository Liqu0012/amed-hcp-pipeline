source /data/juntendodb/amedhcp/pipeline/hokusai/workflow/config/db.env

# One array element = one whole ccalc node (192 CPU, 1.5 TB); sessions run
# concurrently inside it. The account allows 6 nodes in total.
HCP_PACKED_NODE_CPUS=192
HCP_PACKED_NODE_MEM=1500G
HCP_PACKED_MAX_PARALLEL=6

HCP_STRUCTURAL_PACK_SIZE=24
HCP_STRUCTURAL_CPUS_PER_SESSION=8
HCP_STRUCT_TIME=2-00:00:00
HCP_CONVERT_PACK_SIZE=24
HCP_CONVERT_CPUS_PER_SESSION=8
HCP_CONVERT_TIME=04:00:00
HCP_PREEDDY_PACK_SIZE=24
HCP_PREEDDY_CPUS_PER_SESSION=8
HCP_PREEDDY_TIME=08:00:00

# Eddy on GPU (gnode03, H100; account limit h100=4): 2 GPUs per job, 16
# sessions per job spread round-robin over the 2 GPUs. Concurrency per GPU
# is not yet measured on this image -- check nvidia-smi on the first batch.
HCP_EDDY_PARTITION=gcalc2
HCP_EDDY_GRES=gpu:h100:2
HCP_EDDY_NODE_CPUS=32
HCP_EDDY_NODE_MEM=250G   # site limit 8000 MB per CPU
HCP_EDDY_PACK_SIZE=16
HCP_EDDY_CPUS_PER_SESSION=2
HCP_EDDY_MAX_PARALLEL=2
HCP_EDDY_TIME=1-12:00:00

HCP_POSTEDDY_PACK_SIZE=24
HCP_POSTEDDY_CPUS_PER_SESSION=8
HCP_POSTEDDY_TIME=08:00:00
HCP_FMRI_PACK_SIZE=12
HCP_FMRI_CPUS_PER_SESSION=16
HCP_FMRI_TIME=2-00:00:00
HCP_ICAFIX_PACK_SIZE=12
HCP_ICAFIX_CPUS_PER_SESSION=16
HCP_ICAFIX_TIME=1-12:00:00
HCP_MSMALL_PACK_SIZE=12
HCP_MSMALL_CPUS_PER_SESSION=16
HCP_MSMALL_TIME=1-00:00:00
HCP_DEDRIFT_PACK_SIZE=12
HCP_DEDRIFT_CPUS_PER_SESSION=16
HCP_DEDRIFT_TIME=1-00:00:00
HCP_QC_PACK_SIZE=48
HCP_QC_CPUS_PER_SESSION=4
HCP_QC_TIME=02:00:00
