source /data/juntendodb/amedhcp/pipeline/hokusai/workflow/config/db.env

# Jobs carry a copy of the batch script made at submission; make them run the
# current slurm/stage3_worker.sh. Only the batch script itself re-executes.
if [[ "${0##*/}" == slurm_script && -z "${HCP_STAGE3_REEXEC:-}" ]]; then
  export HCP_STAGE3_REEXEC=1
  exec bash /data/juntendodb/amedhcp/pipeline/hokusai/workflow/slurm/stage3_worker.sh "$cfg"
fi

# Rolling stage 3 (fMRI -> MR-FIX -> MSMAll -> DeDrift -> QC) on whole ccalc nodes,
# for every session with .stage1_complete and .stage2_complete.
# Account limits: node=6 shared with stage 1 and the stage-2 GPU job; 8000 MB per CPU.
HCP_QUEUE_DIR=/data/juntendodb/amedhcp/logs/stage3_queue
HCP_WORKER_SLOTS=24
HCP_WORKER_THREADS=8
HCP_WORKER_MEM=1500G
HCP_WORKER_TIME=3-00:00:00
# Longest session chain seen on HOKUSAI is about 10 h; no new claims in the last 12 h.
HCP_WORKER_MARGIN_SEC=43200
HCP_WORKER_POLL_SEC=120
# Watchdog: per-stage wall-clock limits (HOKUSAI p90: fmri 4.3 h, icafix 3.5 h,
# msmall 1.8 h, dedrift 0.3 h) and session-log size limit.
HCP_STAGE3_FMRI_MAX_HOURS=16
HCP_STAGE3_ICAFIX_MAX_HOURS=16
HCP_STAGE3_MSMALL_MAX_HOURS=8
HCP_STAGE3_DEDRIFT_MAX_HOURS=4
HCP_STAGE3_QC_MAX_HOURS=1
HCP_STAGE3_LOG_MAX_GB=5
HCP_STAGE3_IDLE_EXIT_MIN=60
HCP_STAGE3_IDLE_DELAY_MIN=120
