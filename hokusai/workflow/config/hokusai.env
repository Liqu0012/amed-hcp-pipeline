# 2026-10-28: /lustre/tmp_work/ziqing no longer exists. Outputs live under home
# (4 TB quota shared with the raw zips): process in batches of ~70 sessions and
# move finished, QC-passed sessions off HOKUSAI before the next batch.
HCP_STUDY=/home/ziqing/AMED_HCP/hcp_study
HCP_IMAGE=/home/ziqing/tools/qunex_suite-1.5.1.sif
HCP_FS_HOME=
HCP_FS_LICENSE=/home/ziqing/.licenses/freesurfer/license.txt
HCP_STAGE_SCRIPT_DIR=/home/ziqing/hcp_pipeline
HCP_WORKFLOW_LOG_DIR=/home/ziqing/AMED_HCP/hcp_workflow_logs

# Expose the result tree explicitly to both supported runtimes.
SINGULARITY_BINDPATH=/home/ziqing/AMED_HCP
APPTAINER_BINDPATH=/home/ziqing/AMED_HCP

HCP_SLURM_ACCOUNT=rb240007
HCP_SLURM_QOS=normal
HCP_CPU_PARTITION=mpc
HCP_SLURM_EXCLUDE=bwmpc049,bwmpc253
HCP_MAX_PARALLEL=64
HCP_STRUCTURAL_MAX_PARALLEL=12
HCP_CONVERT_MAX_PARALLEL=12
HCP_PREEDDY_MAX_PARALLEL=12
HCP_EDDY_MAX_PARALLEL=12
HCP_POSTEDDY_MAX_PARALLEL=12
HCP_FMRI_MAX_PARALLEL=12
HCP_ICAFIX_MAX_PARALLEL=12
HCP_MSMALL_MAX_PARALLEL=12
HCP_DEDRIFT_MAX_PARALLEL=12
HCP_CONTAINER_RUNTIME=singularity
HCP_SCRATCH_ROOT=/tmp

HCP_STRUCT_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_full_test_session.sh"
HCP_CONVERT_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_convert_session.sh"
HCP_PREEDDY_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_diffusion_preeddy.sh"
HCP_EDDY_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_diffusion_eddy_cpu.sh"
HCP_POSTEDDY_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_diffusion_posteddy.sh"
HCP_FMRI_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_fmri_session.sh"
HCP_ICAFIX_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_icafix_session.sh"
HCP_MSMALL_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_msmall_session.sh"
HCP_DEDRIFT_COMMAND="bash /home/ziqing/hcp_pipeline/hcp_dedrift_session.sh"

HCP_STRUCT_CPUS=112
HCP_STRUCT_MEM=112G
HCP_CONVERT_CPUS=112
HCP_CONVERT_MEM=112G
HCP_PREEDDY_CPUS=112
HCP_PREEDDY_MEM=112G
HCP_EDDY_TIME=12:00:00
HCP_EDDY_CPUS=112
HCP_EDDY_MEM=112G
HCP_POSTEDDY_CPUS=112
HCP_POSTEDDY_MEM=112G
HCP_FMRI_CPUS=112
HCP_FMRI_MEM=112G
HCP_ICAFIX_CPUS=112
HCP_ICAFIX_MEM=112G
HCP_MSMALL_CPUS=112
HCP_MSMALL_MEM=112G
HCP_DEDRIFT_CPUS=112
HCP_DEDRIFT_MEM=112G

# QC gate (hcp_qc_session.py)
HCP_QC_MAX_PARALLEL=12
HCP_QC_TIME=00:30:00
HCP_QC_CPUS=2
HCP_QC_MEM=8G
