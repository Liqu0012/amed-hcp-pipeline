# Required paths
HCP_STUDY=/absolute/path/to/study
HCP_IMAGE=/absolute/path/to/qunex_suite-1.5.1.sif
HCP_FS_HOME=/absolute/path/to/freesurfer-7.4.1
HCP_FS_LICENSE=/absolute/path/to/freesurfer/license.txt
HCP_STAGE_SCRIPT_DIR=/absolute/path/to/hcp_pipeline
HCP_WORKFLOW_LOG_DIR=/absolute/path/to/hcp-workflow-logs
HCP_CONTAINER_RUNTIME=apptainer

# Slurm
HCP_SLURM_ACCOUNT=project-account
HCP_SLURM_QOS=
HCP_CPU_PARTITION=cpu
HCP_MAX_PARALLEL=20

# Stage commands. SESSION and ARCHIVE are appended by the runner.
HCP_STRUCT_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_full_test_session.sh"
HCP_CONVERT_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_convert_session.sh"
HCP_PREEDDY_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_diffusion_preeddy.sh"
HCP_EDDY_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_diffusion_eddy_cpu.sh"
HCP_POSTEDDY_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_diffusion_posteddy.sh"
HCP_FMRI_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_fmri_session.sh"
HCP_ICAFIX_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_icafix_session.sh"
HCP_MSMALL_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_msmall_session.sh"
HCP_DEDRIFT_COMMAND="bash /absolute/path/to/hcp_pipeline/hcp_dedrift_session.sh"
