source /data/juntendodb/amedhcp/pipeline/hokusai/workflow/config/db.env

# Jobs queued before 2026-10-30 carry an older copy of slurm/stage2_gpu_worker.sh (sbatch stores
# the script at submission); make them run the current one. Only the batch script
# itself (slurm_script) re-executes, not run-stage.sh, which also reads this file.
if [[ "${0##*/}" == slurm_script && -z "${HCP_STAGE2_REEXEC:-}" ]]; then
  export HCP_STAGE2_REEXEC=1
  exec bash /data/juntendodb/amedhcp/pipeline/hokusai/workflow/slurm/stage2_gpu_worker.sh "$cfg"
fi

# Rolling stage 2 (GPU eddy + PostEddy) on gnode03 (gcalc2, H100), for every
# session with .stage1_complete. Account limits: h100=4, node=6 (shared with the
# stage-1 CPU nodes), 8000 MB per CPU. Eddy runs on the GPUs (several per GPU),
# PostEddy on the job's CPUs.
HCP_STAGE2_QUEUE_DIR=/data/juntendodb/amedhcp/logs/stage2_queue
HCP_STAGE2_GRES=gpu:h100:4
HCP_STAGE2_MEM=250G
HCP_STAGE2_TIME=3-00:00:00
HCP_STAGE2_EDDY_PER_GPU=3
HCP_STAGE2_EDDY_THREADS=1
HCP_STAGE2_POSTEDDY_SLOTS=4
HCP_STAGE2_POSTEDDY_THREADS=4
HCP_STAGE2_POLL_SEC=60
HCP_STAGE2_MARGIN_SEC=21600
HCP_STAGE2_IDLE_EXIT_MIN=60
HCP_STAGE2_IDLE_DELAY_MIN=120
