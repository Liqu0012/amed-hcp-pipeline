source /home/ziqing/hcp-portable-workflow/config/hokusai.env

# Whole-node pipeline (slurm/hcp_node_pipeline.sh): one job = one whole mpc
# node (112 CPU / 112 GiB) running every stage for the sessions it claims.
# 5% of the node is left for I/O: the scheduler inside uses 106 CPU / 106 GiB.
HCP_NODE_MANIFEST=/home/ziqing/AMED_HCP/manifests/hokusai_chang_node_manifest.tsv
HCP_NODE_QUEUE_DIR=/home/ziqing/AMED_HCP/hcp_workflow_logs/node_pipeline
HCP_NODE_JOB_NAME=hcp_node
HCP_NODE_PARTITION=mpc
HCP_NODE_CPUS=112
HCP_NODE_MEM=112G
HCP_NODE_TIME=1-00:00:00
HCP_NODE_CPU_BUDGET=106
HCP_NODE_MEM_BUDGET_GB=106
HCP_NODE_MAX_SESSIONS=15
HCP_UPLOAD_MIN_AGE_MIN=30

# Per stage: threads, peak memory (GB), expected hours (a stage is started
# only if it fits in the remaining wall time), max concurrent per node.
# Peak memory per session from the Aug-2026 HOKUSAI sacct records (+ margin).
#                         threads  mem_GB  hours  max
HCP_NODE_CONVERT_THREADS=4;    HCP_NODE_CONVERT_MEM_GB=1;     HCP_NODE_CONVERT_HOURS=0.5; HCP_NODE_CONVERT_MAX=26
HCP_NODE_PREEDDY_THREADS=4;    HCP_NODE_PREEDDY_MEM_GB=1.5;   HCP_NODE_PREEDDY_HOURS=1;   HCP_NODE_PREEDDY_MAX=26
# CPU eddy: ~168 CPU-hours and 23-27 GB per session; single-thread eddy would
# need ~7 days (> limits), memory allows 3 per node.
HCP_NODE_EDDY_THREADS=35;      HCP_NODE_EDDY_MEM_GB=27;       HCP_NODE_EDDY_HOURS=16;     HCP_NODE_EDDY_MAX=3
HCP_NODE_STRUCTURAL_THREADS=5; HCP_NODE_STRUCTURAL_MEM_GB=4;  HCP_NODE_STRUCTURAL_HOURS=12; HCP_NODE_STRUCTURAL_MAX=21
HCP_NODE_POSTEDDY_THREADS=5;   HCP_NODE_POSTEDDY_MEM_GB=5;    HCP_NODE_POSTEDDY_HOURS=1;  HCP_NODE_POSTEDDY_MAX=21
HCP_NODE_FMRI_THREADS=10;      HCP_NODE_FMRI_MEM_GB=10;       HCP_NODE_FMRI_HOURS=6;      HCP_NODE_FMRI_MAX=10
HCP_NODE_ICAFIX_THREADS=21;    HCP_NODE_ICAFIX_MEM_GB=19.5;   HCP_NODE_ICAFIX_HOURS=6;    HCP_NODE_ICAFIX_MAX=5
HCP_NODE_MSMALL_THREADS=5;     HCP_NODE_MSMALL_MEM_GB=3.5;    HCP_NODE_MSMALL_HOURS=6;    HCP_NODE_MSMALL_MAX=21
HCP_NODE_DEDRIFT_THREADS=21;   HCP_NODE_DEDRIFT_MEM_GB=19;    HCP_NODE_DEDRIFT_HOURS=1;   HCP_NODE_DEDRIFT_MAX=5
HCP_NODE_QC_THREADS=2;         HCP_NODE_QC_MEM_GB=1;          HCP_NODE_QC_HOURS=0.3;      HCP_NODE_QC_MAX=26
