source /data/juntendodb/amedhcp/pipeline/hokusai/workflow/config/db_stage2.env

# Same rolling stage 2 on gnode01 (gcalc1, 8x L40S 48 GB; account limit l40s=4).
# Shares the stage-2 queue with the H100 worker, so a session is taken by only one.
HCP_STAGE2_GRES=gpu:l40s:4
# gcalc1 allows at most 7 CPUs per L40S (28 for 4 GPUs); 8000 MB per CPU.
# 12 eddy x 1 thread + 4 PostEddy x 4 threads = 28 CPUs.
HCP_STAGE2_MEM=218G
