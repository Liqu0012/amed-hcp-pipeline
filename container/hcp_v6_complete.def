Bootstrap: localimage
From: /data/juntendodb/containers/hcp_connectome_fsl6_mrtrix3-3.0.8_20260828.sif

%labels
    org.humanconnectome.image.title "Complete HCP Pipelines v6 multimodal environment"
    org.humanconnectome.image.version "6.0.0-2026.08.31"
    org.humanconnectome.image.description "Complete sMRI, dMRI, fMRI, FIX, MSMAll, task fMRI, resting-state and tICA environment with licensed MATLAB, compiled MATLAB Runtime and Octave modes"
    org.humanconnectome.image.source "Washington-University/HCPpipelines v6.0.0"

%files
    /data/juntendodb/amed_hcp_runtime/HCPpipelines-v6.0.0 /opt/HCPpipelines-v6.0.0
    hcp_container_entrypoint.sh /usr/local/bin/hcp-container
    validate_hcp_complete.sh /usr/local/bin/validate-hcp-complete
    MATLAB_Runtime_R2022b_Update_10_glnxa64.zip /opt/build/mcr.zip

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get -o Acquire::IndexTargets::deb::Contents-deb::DefaultEnabled=false update
    apt-get install -y --no-install-recommends \
        bc \
        ca-certificates \
        curl \
        dc \
        git \
        libxext6 \
        libxmu6 \
        libxt6 \
        python3-dev \
        python3-nibabel \
        python3-pip \
        python3-pydicom \
        python3-scipy \
        python3-venv \
        r-base \
        r-cran-class \
        r-cran-e1071 \
        r-cran-kernlab \
        r-cran-randomforest \
        r-cran-rocr \
        unzip \
        wget

    # HCP-maintained gradient non-linearity correction implementation.
    wget -q https://github.com/Washington-University/gradunwarp/archive/refs/tags/v1.1.0.tar.gz -O /tmp/gradunwarp.tar.gz
    mkdir -p /tmp/gradunwarp
    tar -xzf /tmp/gradunwarp.tar.gz -C /tmp/gradunwarp --strip-components=1
    sed -i 's/HCP-1\.0\.3/1.0.3/g' /tmp/gradunwarp/setup.py
    # gradunwarp 1.1.0 still contains Python 2 syntax and implicit-relative
    # imports. Patch the SOURCE tree before installing: setup.py uses legacy
    # scripts=[...] install, which copies gradient_unwarp.py into venv/bin/
    # verbatim at install time. Patching the post-install site-packages copy
    # (as before) never touches the file that is actually executed -- that
    # was the root cause of every previous build's identical failure.
    /usr/local/fsl/bin/2to3 -w -n /tmp/gradunwarp/gradunwarp/core
    sed -i \
        's/p = arg.ArgumentParser(version=globals.VERSION, usage=globals.usage)/p = arg.ArgumentParser(usage=globals.usage)/' \
        /tmp/gradunwarp/gradunwarp/core/gradient_unwarp.py
    sed -i \
        '/p = arg.ArgumentParser(usage=globals.usage)/a\    p.add_argument("--version", action="version", version=globals.VERSION)' \
        /tmp/gradunwarp/gradunwarp/core/gradient_unwarp.py
    /usr/bin/python3 -m venv /opt/gradunwarp-venv
    /opt/gradunwarp-venv/bin/pip install --no-cache-dir \
        'pip<25' 'setuptools<70' 'numpy==1.23.5' 'scipy==1.10.1' nibabel pydicom
    /opt/gradunwarp-venv/bin/pip install --no-cache-dir --no-build-isolation /tmp/gradunwarp
    ln -s /opt/gradunwarp-venv/bin/gradient_unwarp.py /usr/local/bin/gradient_unwarp.py

    # HCP v5/v6 compiled MATLAB applications were built with R2022b.
    # Runtime is redistributable and does not check out a MATLAB license.
    mkdir -p /tmp/mcr-installer /opt/mcr/R2022b
    unzip -q /opt/build/mcr.zip -d /tmp/mcr-installer
    /tmp/mcr-installer/install \
        -agreeToLicense yes \
        -mode silent \
        -destinationFolder /opt/mcr/R2022b
    mcr_runtime_dir=$(find /opt/mcr -type d -path '*/runtime/glnxa64' -print -quit)
    test -n "$mcr_runtime_dir"
    mcr_root=${mcr_runtime_dir%/runtime/glnxa64}
    ln -s "$mcr_root" /opt/mcr/current

    # Replace the old HCP code path while retaining compatibility with tools
    # that have the historical path embedded in scripts.
    rm -rf /home/brain/git/HCPpipelines
    mkdir -p /home/brain/git
    ln -s /opt/HCPpipelines-v6.0.0 /home/brain/git/HCPpipelines

    chmod 0555 /usr/local/bin/hcp-container /usr/local/bin/validate-hcp-complete
    chmod -R a+rX /opt/HCPpipelines-v6.0.0 /opt/mcr/R2022b /opt/gradunwarp-venv

    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/gradunwarp /tmp/gradunwarp.tar.gz /tmp/mcr-installer /opt/build

%environment
    export HCPPIPEDIR=/opt/HCPpipelines-v6.0.0
    export HCPPIPEDIR_Global=/opt/HCPpipelines-v6.0.0/global/scripts
    export HCPPIPEDIR_Config=/opt/HCPpipelines-v6.0.0/global/config
    export HCPPIPEDIR_Templates=/opt/HCPpipelines-v6.0.0/global/templates
    export HCPPIPEDIR_PreFS=/opt/HCPpipelines-v6.0.0/PreFreeSurfer/scripts
    export HCPPIPEDIR_FS=/opt/HCPpipelines-v6.0.0/FreeSurfer/scripts
    export HCPPIPEDIR_PostFS=/opt/HCPpipelines-v6.0.0/PostFreeSurfer/scripts
    export HCPPIPEDIR_fMRIVol=/opt/HCPpipelines-v6.0.0/fMRIVolume/scripts
    export HCPPIPEDIR_fMRISurf=/opt/HCPpipelines-v6.0.0/fMRISurface/scripts
    export HCPPIPEDIR_dMRI=/opt/HCPpipelines-v6.0.0/DiffusionPreprocessing/scripts
    export HCPPIPEDIR_tfMRIAnalysis=/opt/HCPpipelines-v6.0.0/TaskfMRIAnalysis/scripts
    export HCPCIFTIRWDIR=/opt/HCPpipelines-v6.0.0/global/matlab/cifti-matlab
    export MSMCONFIGDIR=/opt/HCPpipelines-v6.0.0/MSMConfig
    export MSMBINDIR=/usr/local/fsl/bin
    export MATLAB_COMPILER_RUNTIME=/opt/mcr/current
    export MATLAB_HOME=/opt/matlab/R2024a
    export FSLDIR=/usr/local/fsl
    export FSL_DIR=/usr/local/fsl
    export FREESURFER_HOME=/usr/local/freesurfer/6.0.1
    export CARET7DIR=/usr/bin
    export FSLOUTPUTTYPE=NIFTI_GZ
    export PATH=/opt/matlab/R2024a/bin:/opt/HCPpipelines-v6.0.0/FreeSurfer/custom:/usr/local/bin:/usr/local/fsl/share/fsl/bin:/usr/local/fsl/bin:/usr/local/freesurfer/6.0.1/bin:/usr/bin:/bin:$PATH

%runscript
    exec /usr/local/bin/hcp-container "$@"

%test
    /usr/local/bin/validate-hcp-complete --static
    /usr/local/bin/gradient_unwarp.py --help >/dev/null
